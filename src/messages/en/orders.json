        "t": "Gross",
        "d": "The full price of everything sold, before any discount or VAT."
      },
      "discounts": {
        "t": "Discounts",
        "d": "Money taken off at the till, on a single line or on the whole sale."
      },
      "net": {
        "t": "Net",
        "d": "Gross less discounts: what the sale came to before VAT."
      },
      "vat": {
        "t": "VAT",
        "d": "Tax charged on the discounted prices. It is already inside Total and Sales."
      },
      "total": {
        "t": "Total",
        "d": "What the customer was asked to pay: net plus VAT."
      },
      "paid": {
        "t": "Paid",
        "d": "Money received on the order, less any refunds paid back."
      },
      "refunded": {
        "t": "Refunded",
        "d": "Money handed back to the customer on the order, in full or in part."
      },
      "owed": {
        "t": "Owed",
        "d": "What the customer still has to pay: Sales less Paid less Written off."
      },
      "writtenOff": {
        "t": "Written off",
        "d": "A balance the business chose not to collect (bad debt, dispute or goodwill). It is no longer owed."
      },
      "aov": {
        "t": "Average order value",
        "d": "Sales divided by the number of orders counted."
      },
      "items": {
        "t": "Items sold",
        "d": "The number of tickets, bookings and add-ons on orders that count."
      },
      "counted": {
        "t": "Orders counted",
        "d": "Orders that are not cancelled and not refunded in full. Only these feed Sales, Orders and the breakdowns' money."
